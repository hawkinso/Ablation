# SH = superficial head, ST = superficial trunk, CH = canal head, CT = canal trunk
fish.clean <- fish.raw %>%
filter(!is.na(Super_HeadNum)) %>%
filter_out(Treatment == "0.002% 48h") %>%
rename(SH.raw = Super_HeadNum,
ST.raw = Super_TrunkNum,
CH.raw = Canal_HeadNum,
CT.raw = Canal_TrunkNum
)
fn.order = function(x) {
x$Treatment <- factor(x$Treatment, levels = c("Control", "0.001%", "0.002%", "0.003%"))
x$Species <- factor(x$Species, levels = c("Giant_Danio", "Zebrafish", "Cherry_Barb", "Neon_Tetra", "Black_Tetra"))
levels(x$Treatment)
}
table.means <- fish.num %>% group_by(Species, Treatment) %>%
summarize(SH.means = mean(SH.raw),
ST.means = mean(ST.raw),
CH.means = mean(CH.raw),
CT.means = mean(CT.raw))
table.means <- fish.num %>% group_by(Species, Treatment) %>%
summarize(SH.means = mean(SH.raw),
ST.means = mean(ST.raw),
CH.means = mean(CH.raw),
CT.means = mean(CT.raw))
table.means
table.means <- fish.num %>% group_by(Species, Treatment) %>%
summarize('Mean SH' = mean(SH.raw),
'Mean ST' = mean(ST.raw),
'Mean CH' = mean(CH.raw),
'Mean CT' = mean(CT.raw))
table.means
table.means <- fish.num %>% group_by(Species, Treatment) %>%
summarize('Mean SH' = mean(SH.raw) %>% round(2),
'Mean ST' = mean(ST.raw),
'Mean CH' = mean(CH.raw),
'Mean CT' = mean(CT.raw))
table.means
table.means <- fish.num %>% group_by(Species, Treatment) %>%
summarize(across(
.cols = ends_with(".raw")
.fn = ~ round(mean(.x), 2),
table.means <- fish.num %>% group_by(Species, Treatment) %>%
summarize(across(
.cols = ends_with(".raw"),
.fn = ~ round(mean(.x), 2),
.names = "Mean {.col}"
))
table.means
